# 共通設定。zsh ランチャーは lib/launcher-common.zsh から、
# Python（ask.py / kaggle/build_step2.py）は cli/config.py から読む。
# 個人の値は config.local.env（gitignore 済み）に同じ形式で書くと上書きできる。
# 形式: KEY=VALUE（クォート・空白・変数展開なし）
KAGGLE_USER=yamahei21python
# ビーコンカーネル（公開 URL の掲示板）を置くアカウント。カーネルから push
# できるのは自分のカーネルだけなので、配信カーネルと同じアカウントにする。
KAGGLE_OWNER=yamahei21python
KERNEL_SLUG_CLOUDFLARED=yamahei21python/step2-orcarouter-qwen38-27b-cloudflared
UZU_PORT=9931
UI_PORT=8899
RELAY_PORT=19950
